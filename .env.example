# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# The agent works fully without any keys (fallback to deterministic logic).
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# LLM Configuration (optional — the agent works fully without an LLM)
# The agent uses the LLM only for:
#   1. Refining the execution plan
#   2. Generating a plain-English narrative in the final report
# Raw source code is NEVER sent to the LLM.
# ─────────────────────────────────────────────────────────────────────────────

# --- Option A: Groq (RECOMMENDED — free, fast, OpenAI-compatible) ---
# Sign up at https://console.groq.com → API Keys → Create key
# Free tier: 14,400 req/day, 6,000 tokens/min — more than enough
#
LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=llama-3.1-8b-instant
LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Option B: Other Groq models (uncomment one to switch) ---
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_MODEL=mixtral-8x7b-32768
# LLM_MODEL=gemma2-9b-it

# --- Option C: OpenAI (if you have a key) ---
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# ─────────────────────────────────────────────────────────────────────────────
# GitHub Token (optional — raises rate limit from 60 → 5,000 req/hr)
# Generate at: https://github.com/settings/tokens → New token (no scopes needed for public repos)
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Analysis Limits (optional — safe defaults shown)
# ─────────────────────────────────────────────────────────────────────────────
MAX_FILES=30
MAX_FILE_SIZE=50000
